{
  "template": "sdlc-config 1",
  "schema": 1,
  "verify": "mvn -f backend/pom.xml verify && (cd frontend && npm run lint && npm run build && npx tsc --noEmit && npm test && npm run test:e2e:isolated)",
  "spec_gate": "always",
  "merge": "auto",
  "max_implementers": 3,
  "ticket_budget_turns": 60,
  "session_budget_features": 3,
  "max_pending_acceptance": 3,
  "debt_threshold_per_module": 5,
  "map_max_lines": 120,
  "module_roots": [
    "backend/src/main/java/com/remotesupport/backend",
    "frontend/app",
    "frontend/components",
    "frontend/lib"
  ],
  "test_globs": [
    "**/*.test.*",
    "**/*.spec.*",
    "**/src/test/**"
  ],
  "main_branch": "main",
  "pull_requests": true,
  "forbidden_commands": [],
  "skills": {
    "interview": "bundled",
    "domain": "bundled",
    "tdd": "bundled",
    "debugging": "bundled",
    "design": "impeccable"
  }
}
